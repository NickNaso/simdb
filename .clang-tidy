---
# Conservative clang-tidy configuration for simdb.
# Only checks .cpp translation units; simdb.hpp is excluded via HeaderFilterRegex
# to avoid noise from the low-level, platform-specific header implementation.
Checks: >
  -*,
  bugprone-use-after-move,
  bugprone-dangling-handle,
  bugprone-infinite-loop,
  bugprone-assert-side-effect,
  bugprone-bool-pointer-implicit-conversion,
  bugprone-branch-clone,
  clang-analyzer-core.NullDereference,
  clang-analyzer-core.uninitialized.Assign,
  clang-analyzer-cplusplus.Move,
  clang-analyzer-cplusplus.NewDelete,
  clang-analyzer-cplusplus.NewDeleteLeaks,
  performance-unnecessary-copy-initialization,
  performance-unnecessary-value-param,
  readability-redundant-smartptr-get,

# Only surface diagnostics originating inside the tests/ directory.
# This keeps the complex platform-specific simdb.hpp out of tidy reports.
HeaderFilterRegex: '.*/tests/.*'

# Promote these high-confidence checks to errors so the CI job fails on real bugs.
WarningsAsErrors: >
  bugprone-use-after-move,
  bugprone-dangling-handle,
  clang-analyzer-cplusplus.Move,
  clang-analyzer-cplusplus.NewDelete,
  clang-analyzer-cplusplus.NewDeleteLeaks,

FormatStyle: file
